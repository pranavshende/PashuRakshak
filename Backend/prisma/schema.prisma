datasource db {
  provider  = "postgresql"
}
 
generator client {
  provider = "prisma-client-js"
}
 
enum Role {
  FARMER
  VET
  ADMIN
}
 
model User {
  id                  String   @id @default(uuid())
  name                String
  phone               String   @unique
  email               String?
  farmName            String?
  password            String?  // Made optional in case of Supabase Auth
  role                Role     @default(FARMER)
  language            String   @default("English")
  notificationsEnabled Boolean  @default(true)
  createdAt           DateTime @default(now())
  predictions         Prediction[]
  animals             Animal[]
  communityPosts      CommunityPost[]
  communityLikes      CommunityLike[]
  communityComments   CommunityComment[]
  conversations       Conversation[]
}
 
model Prediction {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  disease     String
  confidence  Decimal
  riskLevel   String
  imagePath   String?
  createdAt   DateTime  @default(now())
  syncedAt    DateTime?
  symptom     Symptom?
  animalId    String?
  animal      Animal?   @relation(fields: [animalId], references: [id])
  recoveryStatus String? // e.g. "Recovering", "Healed", "Worsening"
  @@index([userId])
}
 
model Symptom {
  id            String     @id @default(uuid())
  predictionId  String     @unique
  prediction    Prediction @relation(fields: [predictionId], references: [id], onDelete: Cascade)
  symptomData   Json
}
 
model Medicine {
  id                 String @id @default(uuid())
  diseaseKey         String
  name               String
  usageInstructions  String
}
 
model Vet {
  id        String  @id @default(uuid())
  name      String
  phone     String
  latitude  Float
  longitude Float
  location  Unsupported("geography(Point, 4326)")?
}

model Animal {
  id                String         @id @default(uuid())
  tagId             String         @unique // For QR Codes
  name              String?
  breed             String?
  gender            String?        // Male/Female
  dateOfBirth       DateTime?
  weight            Float?         // Latest weight
  userId            String
  user              User           @relation(fields: [userId], references: [id])
  createdAt         DateTime       @default(now())
  
  // IoT Sensor Fields
  temperature       Float?
  heartRate         Float?
  ruminationTime    Float?
  activityLevel     Float?
  latitude          Float?
  longitude         Float?
  sensorStatus      String?        // e.g. "LIVE", "OFFLINE", "NONE"
  lastSensorUpdate  DateTime?

  vaccinations Vaccination[]
  milkRecords  MilkRecord[]
  predictions  Prediction[]
}

model Vaccination {
  id          String   @id @default(uuid())
  animalId    String
  animal      Animal   @relation(fields: [animalId], references: [id], onDelete: Cascade)
  vaccineName String
  dateAdministered DateTime
  nextDueDate DateTime?
}

model MilkRecord {
  id          String   @id @default(uuid())
  animalId    String
  animal      Animal   @relation(fields: [animalId], references: [id], onDelete: Cascade)
  date        DateTime @default(now())
  quantityLiters Float
}

model DiseaseReport {
  id          String   @id @default(uuid())
  diseaseName String
  latitude    Float
  longitude   Float
  severity    String   @default("Medium") // High, Medium, Low
  reportedAt  DateTime @default(now())
}

model CommunityPost {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  text      String
  tags      String[] // Array of strings (e.g. ["Alert", "FMD"])
  location  String?
  createdAt DateTime @default(now())
  likes     CommunityLike[]
  comments  CommunityComment[]
}

model CommunityLike {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId    String
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@unique([userId, postId])
}

model CommunityComment {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId    String
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  text      String
  createdAt DateTime @default(now())
}

model Conversation {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String?
  createdAt DateTime @default(now())
  messages  Message[]
}

model Message {
  id             String   @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         String   // "user" or "bot"
  text           String
  createdAt      DateTime @default(now())
}
